# Mini-C grammar after the transformations needed for predictive parsing.
# One rule here = one parse function in src/parser.cpp.
#
#  1. Precedence: the ambiguous `rval` is split into one non-terminal per
#     precedence level, lowest first (|| < && < == != < relational < + - < * / %).
#  2. Left-recursion elimination:  A ::= A α | β   becomes   A ::= β A' ; A' ::= α A' | ε
#     (extern_list, decl_list, param_list, local_decls, stmt_list, arg_list, and
#     every binary-operator level).
#  3. Left factoring of common prefixes: decl (var_decl vs fun_decl both start
#     with "type IDENT"), return_stmt, and IDENT vs IDENT "(" args ")" in primary.
#
# The one remaining LL(1) conflict is in `expr` on IDENT (assignment vs. an
# expression starting with a variable). The parser resolves it with a second
# token of lookahead: IDENT followed by "=" means assignment.
# Verify with:  node tools/ll1.mjs grammar/minic-ll1.bnf

program          ::= extern_list decl_list
                   | decl_list
extern_list      ::= extern extern_list'
extern_list'     ::= extern extern_list'
                   | ε
extern           ::= "extern" type_spec IDENT "(" params ")" ";"
decl_list        ::= decl decl_list'
decl_list'       ::= decl decl_list'
                   | ε
decl             ::= type_spec IDENT decl_tail
decl_tail        ::= ";"
                   | "(" params ")" block
type_spec        ::= "void"
                   | var_type
var_type         ::= "int" | "float" | "bool"
params           ::= param_list
                   | "void"
                   | ε
param_list       ::= param param_list'
param_list'      ::= "," param param_list'
                   | ε
param            ::= var_type IDENT
block            ::= "{" local_decls stmt_list "}"
local_decls      ::= local_decl local_decls
                   | ε
local_decl       ::= var_type IDENT ";"
stmt_list        ::= stmt stmt_list
                   | ε
stmt             ::= expr_stmt
                   | block
                   | if_stmt
                   | while_stmt
                   | return_stmt
expr_stmt        ::= expr ";"
                   | ";"
while_stmt       ::= "while" "(" expr ")" stmt
if_stmt          ::= "if" "(" expr ")" block else_stmt
else_stmt        ::= "else" block
                   | ε
return_stmt      ::= "return" return_value ";"
return_value     ::= expr
                   | ε

expr             ::= IDENT "=" expr
                   | or_expr
or_expr          ::= and_expr or_expr'
or_expr'         ::= "||" and_expr or_expr'
                   | ε
and_expr         ::= equality_expr and_expr'
and_expr'        ::= "&&" equality_expr and_expr'
                   | ε
equality_expr    ::= relational_expr equality_expr'
equality_expr'   ::= "==" relational_expr equality_expr'
                   | "!=" relational_expr equality_expr'
                   | ε
relational_expr  ::= additive_expr relational_expr'
relational_expr' ::= "<" additive_expr relational_expr'
                   | "<=" additive_expr relational_expr'
                   | ">" additive_expr relational_expr'
                   | ">=" additive_expr relational_expr'
                   | ε
additive_expr    ::= multiplicative_expr additive_expr'
additive_expr'   ::= "+" multiplicative_expr additive_expr'
                   | "-" multiplicative_expr additive_expr'
                   | ε
multiplicative_expr  ::= unary_expr multiplicative_expr'
multiplicative_expr' ::= "*" unary_expr multiplicative_expr'
                       | "/" unary_expr multiplicative_expr'
                       | "%" unary_expr multiplicative_expr'
                       | ε
unary_expr       ::= "-" unary_expr
                   | "!" unary_expr
                   | primary
primary          ::= IDENT ident_tail
                   | INT_LIT
                   | FLOAT_LIT
                   | BOOL_LIT
                   | "(" expr ")"
ident_tail       ::= "(" args ")"
                   | ε
args             ::= arg_list
                   | ε
arg_list         ::= expr arg_list'
arg_list'        ::= "," expr arg_list'
                   | ε
